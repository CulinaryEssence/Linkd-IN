# Copy this file to .env and fill in your own values.
# Never commit the real .env file to git or share it publicly.

# From your LinkedIn Developer app (https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# Must exactly match a redirect URL you added in your LinkedIn app's Auth settings.
# For local testing: http://localhost:3000/auth/linkedin/callback
# Once deployed: https://your-deployed-domain.com/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# A password you make up yourself — protects the approval dashboard so
# random visitors can't post to your LinkedIn. Use a long, random string.
DASHBOARD_PASSWORD=change_me_to_something_long_and_random

# Port the server runs on locally. Most hosts (Render, Railway, etc.) set
# this automatically, so you usually don't need to change it in production.
PORT=3000
